{
  "name": "liquidglass-root",
  "private": true,
  "workspaces": [
    "packages/*",
    "demo"
  ],
  "scripts": {
    "dev": "npm run build:package && npm run dev:demo",
    "dev:demo": "npm run dev --workspace=demo",
    "build": "npm run build:package && npm run build:demo",
    "build:package": "npm run build --workspace=packages/liquidglass",
    "build:demo": "npm run build --workspace=demo",
    "lint": "npm run lint --workspace=demo"
  }
}
